# ============================================================ #
# Stellar ThreatNet — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================ #

# --- Security (MUST change in production) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret

# --- Databases ---
DATABASE_URL=postgresql+asyncpg://threatnet_user:threatnet_pass@postgres:5432/stellar_threatnet
REDIS_URL=redis://redis:6379/0

# --- Caching ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute

# --- AI (mock is the safe default) ---
AI_PROVIDER=mock
OPENAI_API_KEY=

# --- CORS (JSON array of allowed dashboard origins) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- PostgreSQL (used by the compose file) ---
POSTGRES_USER=threatnet_user
POSTGRES_PASSWORD=threatnet_pass
POSTGRES_DB=stellar_threatnet
